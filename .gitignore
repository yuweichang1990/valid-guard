# ========================
# Valid Guard reports
# ========================
# Generated HTML reports are gitignored (ephemeral artifacts)
valid-guard/reports/**
!valid-guard/reports/.gitkeep

# ========================
# Keep these directories tracked
# ========================
# valid-guard/plans/     — tracked (test plans are source artifacts)
# valid-guard/templates/ — tracked (report templates are source)

